# ============================================================
# Cevano IT Solutions — .gitignore
# ============================================================

# --- Secrets & local environment files — NEVER commit these ---
# Cloudflare Pages secrets (RESEND_API_KEY, TURNSTILE_SECRET_KEY, etc.) are
# set in the Cloudflare dashboard or via `wrangler pages secret put`, never
# stored in the repo. If you use Wrangler locally for testing, it reads
# secrets from a .dev.vars file — that file must never be committed.
.dev.vars
.dev.vars.*
!.dev.vars.example
*.env
.env
.env.*
!.env.example

# --- Python build-script artifacts (dev tooling only, see build.py) ---
__pycache__/
*.pyc

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Wrangler / Cloudflare local state ---
.wrangler/
node_modules/
